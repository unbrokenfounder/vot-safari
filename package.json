{
  "name": "vot-safari",
  "version": "1.12.8",
  "author": "Toil",
  "license": "MIT",
  "description": "Озвучка и субтитры к видео на других языках в Safari",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbrokenfounder/vot-safari.git"
  },
  "keywords": [
    "safari",
    "extension",
    "voice-over-translation",
    "vot"
  ],
  "imports": {
    "#modules/*": "./src/modules/*",
    "#core/*": "./src/core/*",
    "#utils/*": "./src/utils/*",
    "#types/*": "./src/types/*",
    "#config/*": "./src/config/*",
    "#stores/*": "./src/stores/*",
    "#components/*": "./src/components/*",
    "#extension/*": "./src/extension/*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@toil/translate": "^1.10.0",
    "@types/node": "^26.6.6",
    "@wxt-dev/module-solid": "^1.1.4",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wxt": "^0.21.5"
  },
  "scripts": {
    "dev": "DEBUG_MODE=true wxt",
    "build": "wxt build",
    "build:debug": "wxt build --mode development",
    "check": "tsc -p ./src/tsconfig.json --noEmit",
    "lint": "biome lint ./src ./vite",
    "format": "biome check --write ./src ./vite",
    "localize": "bunx \"@toil/localize-tui\"",
    "postinstall": "wxt prepare",
    "build:safari": "bash scripts/build-safari.sh",
    "package:safari": "bash scripts/package-safari.sh"
  },
  "dependencies": {
    "@toil/gm-types": "^1.0.6",
    "@vot.js/core": "^3.2.1",
    "@vot.js/ext": "^3.2.1",
    "@vot.js/shared": "^3.2.1",
    "astring": "1.9.0",
    "bowser": "^2.15.0",
    "chaimu": "^1.1.0",
    "googlevideo": "^5.0.1",
    "meriyah": "7.4.0",
    "solid-js": "^1.9.18"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.2.0"
  }
}
